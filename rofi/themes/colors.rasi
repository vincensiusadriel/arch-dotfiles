* {
    /* Generated by matugen */
    bg-col:         #121318;
    bg-col-light:   #292a2f;
    border-col:     #45464f;
    accent:         #b9c3ff;
    fg-col:         #e3e1e9;
    fg-col2:        #e5bad9;
    grey:           #c6c5d0;
    network:        #c3c5dd;
    bluetooth:      #424659;
    wallpaper:      #384379;
    music:          #5c3c56;

    /* Aliases */
    background:     @bg-col;
    background-alt: @bg-col-light;
    foreground:     @fg-col;
    selected:       @accent;

    width:          600;
    font:           "GeistMono Nerd Font Propo 13";
}
