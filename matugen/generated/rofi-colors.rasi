* {
    /* Generated by matugen */
    bg-col:         #11140f;
    bg-col-light:   #272b25;
    border-col:     #43483f;
    accent:         #a6d394;
    fg-col:         #e1e4da;
    fg-col2:        #a0cfd1;
    grey:           #c3c8bc;
    network:        #bbcbb1;
    bluetooth:      #3d4b36;
    wallpaper:      #2a4f1f;
    music:          #1e4e50;

    /* Aliases */
    background:     @bg-col;
    background-alt: @bg-col-light;
    foreground:     @fg-col;
    selected:       @accent;

    width:          600;
    font:           "GeistMono Nerd Font Propo 13";
}
