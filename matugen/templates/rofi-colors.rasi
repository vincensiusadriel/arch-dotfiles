* {
    /* Generated by matugen */
    bg-col:         {{colors.background.default.hex}};
    bg-col-light:   {{colors.surface_container_high.default.hex}};
    border-col:     {{colors.outline_variant.default.hex}};
    accent:         {{colors.primary.default.hex}};
    fg-col:         {{colors.on_surface.default.hex}};
    fg-col2:        {{colors.tertiary.default.hex}};
    grey:           {{colors.on_surface_variant.default.hex}};
    network:        {{colors.secondary.default.hex}};
    bluetooth:      {{colors.secondary_container.default.hex}};
    wallpaper:      {{colors.primary_container.default.hex}};
    music:          {{colors.tertiary_container.default.hex}};

    /* Aliases */
    background:     @bg-col;
    background-alt: @bg-col-light;
    foreground:     @fg-col;
    selected:       @accent;

    width:          600;
    font:           "GeistMono Nerd Font Propo 13";
}
